          <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
            {/* SEARCH */}
            <div>
              <label htmlFor="paymentSearch" className="block text-[11px] font-bold text-[#7A7A7A] mb-1">
