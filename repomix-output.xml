      initial={shouldReduceMotion ? "visible" : "hidden"}
      animate={shouldReduceMotion ? "visible" : "visible"}
      variants={shouldReduceMotion ? {} : floatingVariants}
      transition={{ delay }}
      className={className}
      {...props}
