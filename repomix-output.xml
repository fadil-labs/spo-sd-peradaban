  colorVariant?: "green" | "yellow" | "blue" | "teal";
  trend?: {
    value: string;
    positive: boolean;
  };
  accent?: boolean;
}

const iconMap = {
  Receipt,
  Users,
  FileCheck,
  CreditCard,
};

const colorStyles = {
  green: {
    bgIcon: "bg-[#0C3B2E]/10 text-[#0C3B2E]",
    trendText: "text-[#0C3B2E]",
