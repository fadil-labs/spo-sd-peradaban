        r.paymentCategoryName || "-",
        r.billingPeriodStart && r.billingPeriodEnd ? `${formatDate(r.billingPeriodStart)} - ${formatDate(r.billingPeriodEnd)}` : "-",
        formatCurrency(r.billAmount),
